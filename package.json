{
  "name": "c-language-tutorial",
  "version": "1.0.0",
  "description": "C言語学習教材",
  "scripts": {
    "docs:publish": "npm run docs:publish:book && npm run docs:publish:exercises",
    "docs:publish:book": "uv run --script scripts/build_book.py --render",
    "docs:publish:exercises": "uv run --script scripts/build_book.py --edition exercises --render",
    "docs:check": "npm run docs:check:book && npm run docs:check:exercises",
    "docs:check:book": "uv run --script scripts/build_book.py",
    "docs:check:exercises": "uv run --script scripts/build_book.py --edition exercises",
    "lint:ja": "uv run --script scripts/build_book.py --audit-only",
    "c:check": "python3 scripts/check_c_examples.py",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore output",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore output --fix",
    "check": "npm run lint:ja && npm run lint:md && npm run c:check && npm run docs:check",
    "fix": "npm run lint:md:fix"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.37.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zabaglione/c-language-tutorial.git"
  },
  "keywords": [
    "c",
    "programming",
    "tutorial",
    "japanese"
  ],
  "author": "",
  "license": "MIT"
}
